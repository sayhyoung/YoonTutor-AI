<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 잠금 화면 위로 전화 수신 화면을 띄우고 벨·진동을 울린다. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- expo-notifications 서비스(우선순위 -1)보다 먼저 받아, 전화·사전 알림만 직접 띄우고 나머지는 넘긴다. -->
    <service
      android:name="expo.modules.callringer.CallMessagingService"
      android:exported="false">
      <intent-filter android:priority="10">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <receiver
      android:name="expo.modules.callringer.CallAlertReceiver"
      android:exported="false" />
    <!-- 잠금 화면 수신 화면(전체 화면 알림). 잠금 화면 위 표시·화면 켜기를 여기서 선언해야
         삼성 One UI 7 등에서도 화면이 그려진다(앱 화면에서 코드로 켜면 검은 화면만 보였다). -->
    <activity
      android:name="expo.modules.callringer.IncomingCallActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:launchMode="singleInstance"
      android:screenOrientation="portrait"
      android:showWhenLocked="true"
      android:taskAffinity="expo.modules.callringer.incoming"
      android:theme="@style/CallRingerIncomingTheme"
      android:turnScreenOn="true" />
  </application>
</manifest>
