<?xml version="1.0" encoding="utf-8"?>
<!-- 잠금 화면 수신 화면. 앱의 밝은 수신 화면(App.tsx IncomingScreen)과 같은 구성이다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/call_ringer_paper"
  android:fitsSystemWindows="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="40dp"
    android:paddingEnd="28dp"
    android:paddingBottom="32dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/call_ringer_kicker"
      android:textColor="@color/call_ringer_muted"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="@string/call_ringer_title"
      android:textColor="@color/call_ringer_ink"
      android:textSize="28sp"
      android:textStyle="bold" />

    <Space
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <FrameLayout
      android:layout_width="220dp"
      android:layout_height="220dp">

      <View
        android:id="@+id/call_ringer_pulse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/call_ringer_ripple" />

      <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:background="@drawable/call_ringer_halo" />

      <ImageView
        android:id="@+id/call_ringer_avatar"
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_gravity="center"
        android:background="@drawable/call_ringer_avatar_bg"
        android:contentDescription="@string/call_ringer_avatar_label"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/call_ringer_befly" />
    </FrameLayout>

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/call_ringer_name"
      android:textColor="@color/call_ringer_ink"
      android:textSize="24sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:background="@drawable/call_ringer_bubble"
      android:orientation="vertical"
      android:paddingStart="18dp"
      android:paddingTop="14dp"
      android:paddingEnd="18dp"
      android:paddingBottom="14dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/call_ringer_greeting_en"
        android:textColor="@color/call_ringer_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxWidth="244dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/call_ringer_greeting_ko"
        android:textColor="@color/call_ringer_ink"
        android:textSize="16sp" />
    </LinearLayout>

    <Space
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/call_ringer_later"
          android:layout_width="72dp"
          android:layout_height="72dp"
          android:background="@drawable/call_ringer_button_later"
          android:contentDescription="@string/call_ringer_later"
          android:src="@drawable/call_ringer_ic_clock" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:importantForAccessibility="no"
          android:text="@string/call_ringer_later"
          android:textColor="@color/call_ringer_ink"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/call_ringer_answer"
          android:layout_width="72dp"
          android:layout_height="72dp"
          android:background="@drawable/call_ringer_button_answer"
          android:contentDescription="@string/call_ringer_answer"
          android:src="@drawable/call_ringer_ic_phone" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:importantForAccessibility="no"
          android:text="@string/call_ringer_answer"
          android:textColor="@color/call_ringer_ink"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
