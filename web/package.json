{
  "name": "yoon-ai-tutor-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:rules": "vitest run src/lib/firebase/*.rules.test.ts",
    "test:emulator": "cross-env XDG_CONFIG_HOME=.firebase-config firebase emulators:exec --only firestore \"npm run test:rules\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "firebase": "cross-env XDG_CONFIG_HOME=.firebase-config firebase",
    "firebase:login": "cross-env XDG_CONFIG_HOME=.firebase-config firebase login",
    "firebase:emulators": "cross-env XDG_CONFIG_HOME=.firebase-config firebase emulators:start --only auth,firestore",
    "firebase:deploy:firestore": "cross-env XDG_CONFIG_HOME=.firebase-config firebase deploy --only firestore",
    "firebase:deploy:hosting-config": "cross-env XDG_CONFIG_HOME=.firebase-config firebase deploy --only firestore"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "cross-env": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "firebase-tools": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
