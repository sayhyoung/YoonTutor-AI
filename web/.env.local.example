# Firebase web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_MODE=anonymous

# AI server config
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Keep true until the external learning API and real auth are ready.
USE_MOCK_AI=true

# 회원 학습데이터(study-api) 연동
# 학습 소스 선택: mock(기본) | external-api
NEXT_PUBLIC_LEARNING_SOURCE=mock
# study-api base URL (HTTPS). 외부 연동 테스트용 프록시가 추가되어 VPN 없이도 호출 가능.
#   외부 연동용(권장 · 클라우드 배포/로컬 공통): https://test-study-api.yoons.or.kr
#   내부망용(Swagger 포함): https://study-api.yoons.or.kr
LEARNING_API_BASE_URL=
LEARNING_API_KEY=
# 학습조회는 기간(range)으로 조회한다. 조회 기간(일), 기본 90일(최대 365).
STUDY_API_LOOKBACK_DAYS=90
# 테스트용 고정 조회 기간(YYYY-MM-DD). 비우면 최근 LOOKBACK일.
STUDY_API_DEMO_START=
STUDY_API_DEMO_END=
# 단일 날짜만 테스트할 때(START/END 둘 다로 사용됨)
STUDY_API_DEMO_DATE=
# 학습조회 API에 인증이 적용되면 사용할 accessToken(현재는 불필요)
# STUDY_API_ACCESS_TOKEN=
# 로그인 API 연동 시 사용(현재 미확정)
# STUDY_API_CLIENT_ID=study-api
# STUDY_API_DEVICE_TYPE=web

# 모바일 전화관리 BFF 세션 서명 키. 운영 환경에서 32자 이상의 임의 문자열로 설정.
# 실제 값은 저장소에 커밋하지 않는다.
CALL_REVIEW_SESSION_SECRET=

# --- AI 전화관리(call-review) 추가 설정 ---
# 통화 결과·일정 저장: 로컬은 Firestore 에뮬레이터(FIRESTORE_EMULATOR_HOST=127.0.0.1:8080)를 쓰고,
# 운영 Firestore에 쓰려면 enabled. 둘 다 없으면 저장 API는 503.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# CALL_REVIEW_FIRESTORE=enabled
# 웹에서 모바일 API를 호출할 출처 목록(쉼표 구분). 개발 중에는 localhost가 자동 허용된다.
# CALL_REVIEW_MOBILE_ORIGINS=
# 푸시 예약 작업(/api/call-review/dispatch) 호출 인증값. 32자 이상.
CALL_REVIEW_CRON_SECRET=
# 예약 발송(Cloud Scheduler)을 만든 뒤 enabled. 그 전에는 앱이 기기 자체 알림을 쓴다.
# CALL_REVIEW_PUSH_DISPATCH=enabled
# (선택) 짧은 대화 질문용 모델. 비우면 OPENAI_MODEL.
# CALL_REVIEW_FREE_TALK_MODEL=
# (선택) 음성 인식 모델. 비우면 whisper-1.
# OPENAI_STT_MODEL=
# (선택) Expo 푸시 보안 설정(Enhanced Security)을 켠 경우의 액세스 토큰.
# EXPO_ACCESS_TOKEN=
# 음성 인식(STT): Azure Speech(Fast Transcription). 설정이 없으면 OpenAI 음성 인식을 쓴다.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=koreacentral
# (선택) 사용자 지정 도메인을 쓰는 경우: AZURE_SPEECH_ENDPOINT=https://<리소스>.cognitiveservices.azure.com
# 읽어 주기(TTS): Gemini TTS. 설정이 없으면 앱이 기기 음성으로 읽는다.
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=
# GEMINI_TTS_VOICE=Kore
