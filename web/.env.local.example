# Firebase web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_MODE=anonymous

# AI server config
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Keep true until the external learning API and real auth are ready.
USE_MOCK_AI=true

# 회원 학습데이터(study-api) 연동
# 학습 소스 선택: mock(기본) | external-api
NEXT_PUBLIC_LEARNING_SOURCE=mock
# study-api base URL (HTTPS). 외부 연동 테스트용 프록시가 추가되어 VPN 없이도 호출 가능.
#   외부 연동용(권장 · 클라우드 배포/로컬 공통): https://test-study-api.yoons.or.kr
#   내부망용(Swagger 포함): https://study-api.yoons.or.kr
LEARNING_API_BASE_URL=
LEARNING_API_KEY=
# 학습조회는 기간(range)으로 조회한다. 조회 기간(일), 기본 90일(최대 365).
STUDY_API_LOOKBACK_DAYS=90
# 테스트용 고정 조회 기간(YYYY-MM-DD). 비우면 최근 LOOKBACK일.
STUDY_API_DEMO_START=
STUDY_API_DEMO_END=
# 단일 날짜만 테스트할 때(START/END 둘 다로 사용됨)
STUDY_API_DEMO_DATE=
# 학습조회 API에 인증이 적용되면 사용할 accessToken(현재는 불필요)
# STUDY_API_ACCESS_TOKEN=
# 로그인 API 연동 시 사용(현재 미확정)
# STUDY_API_CLIENT_ID=study-api
# STUDY_API_DEVICE_TYPE=web
